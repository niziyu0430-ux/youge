              "label": "绕进还没走过的院落或林间小路，看看这里的生活",
              "signal": "wanderer"
            },
            {
              "id": "B",
              "label": "接着找惦记的人物交谈，听他那件事的后续",
              "signal": "story_keeper"
            },
