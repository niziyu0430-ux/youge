          "question_type": "situational_action",
          "source_ids": [
            "litt1v5_core",
            "litt1v5_prison"
          ],
          "modes": [],
          "options": [
            {
              "id": "A",
              "label": "举着火光去小口后看看，不先要求那里有收藏",
              "signal": "wanderer"
            },
            {
              "id": "B",
              "label": "先猜暗处边缘能否攀上，用火光看清后亲自试一下核对",
              "signal": "puzzle_breaker"
            },
            {
              "id": "C",
              "label": "练自己从箱顶抓到出口边缘的一拍，只比刚才顺不顺",
              "signal": "practice_seeker"
            },
            {
              "id": "D",
              "label": "沿已走熟的小段跑跳，享受小脚步、抓边与落地回馈",
              "signal": "feedback_engine"
            }
          ],
          "design_purpose": "一代使用打火机和Six基础动作，不混二代手电与电视穿越。",
          "interpretation_boundary": "只解释这次情境的偏好；不由效率、胜负或未体验推断能力与现实人格。",
          "id": "LITT1V501.V1"
        },
