            {
              "id": "B",
              "label": "先猜从矮处起跳能抓到哪里，再用打火机看清并试一次",
              "signal": "puzzle_breaker"
            },
            {
              "id": "C",
              "label": "重复自己跳起后抓住边缘的一下，只与上一回比较",
              "signal": "practice_seeker"
            },
            {
              "id": "D",
              "label": "跑过已经熟悉的矮处，感受抓牢、翻上与脚步接起来的反馈",
              "signal": "feedback_engine"
