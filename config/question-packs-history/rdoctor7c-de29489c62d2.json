  "slots": [
    {
      "id": "RDOCTOR7C01",
      "number": 1,
      "variants": [
        {
          "text": "当前是已玩过的普通七拍患者，一轮心跳结束要在第七拍输入；能从头再试，不必争最高评价。先怎样用这轮？",
          "scene": "七拍中真正按下的那一下",
          "question_type": "situational_action",
          "source_ids": [
            "RDOC7_STORE"
          ],
          "modes": [],
          "options": [
            {
              "id": "A",
              "label": "只专练第六拍等到第七拍再按的时机",
              "signal": "practice_seeker"
            },
            {
              "id": "B",
              "label": "比较心跳声与自己落键的位置，验证先前是从哪一拍数偏",
              "signal": "puzzle_breaker"
            },
            {
              "id": "C",
              "label": "顺着心跳和音乐把一轮轮输入接上，投入即时回应",
              "signal": "feedback_engine"
            },
            {
              "id": "D",
              "label": "先重看这一患者的七拍输入教学，再回关卡确认",
              "signal": "rhythm_reference_first"
            }
          ],
          "design_purpose": "把专练、机制解释、连续反馈和核对说明分开，不推断节奏能力或医疗品德。",
          "interpretation_boundary": "只解释这次情境的偏好；不由效率、胜负或未体验推断能力与现实人格。",
          "id": "RDOCTOR7C01.V1"
        },
        {
          "text": "只玩过最早的一位普通七拍患者，眼前能把同一关从头再打一遍。先给什么注意？",
          "scene": "七拍中真正按下的那一下的另一情境",
          "question_type": "situational_action",
          "source_ids": [
            "RDOC7_STORE"
          ],
          "modes": [],
          "options": [
            {
              "id": "A",
              "label": "只练最后两拍之间等待再按的那一下",
              "signal": "practice_seeker"
            },
            {
              "id": "B",
              "label": "用心跳声检验自己对第七拍位置的判断",
              "signal": "puzzle_breaker"
            },
            {
              "id": "C",
              "label": "让一次次输入接上音乐，享受心跳回应",
              "signal": "feedback_engine"
            },
            {
              "id": "D",
              "label": "先回看最早七拍教学，再开始这一轮",
              "signal": "rhythm_reference_first"
            }
          ],
          "design_purpose": "把专练、机制解释、连续反馈和核对说明分开，不推断节奏能力或医疗品德。",
          "interpretation_boundary": "只解释这次情境的偏好；不由效率、胜负或未体验推断能力与现实人格。",
          "id": "RDOCTOR7C01.ALT1"
        }
      ]
    },
    {
      "id": "RDOCTOR7C02",
      "number": 2,
      "variants": [
        {
          "text": "你已学过行上的红叉会让相应心跳静音；当前熟悉句里有红叉，随后恢复声音，能再试。先做什么？",
          "scene": "红叉静音后还要接回心跳",
          "question_type": "situational_action",
          "source_ids": [
            "RDOC7_XS",
            "RDOC7_STORE"
          ],
          "modes": [],
          "options": [
            {
              "id": "A",
              "label": "提出红叉前后计拍怎样不断的解释，再用恢复的声音验证",
              "signal": "puzzle_breaker"
            },
            {
              "id": "B",
              "label": "顺着已经会的计拍连续输入，体会声音消失又接回时的回应",
              "signal": "feedback_engine"
            },
            {
              "id": "C",
              "label": "回正常演奏，明确以超过这关个人旧评价或准确率为目标试一轮",
              "signal": "rank_worker"
            },
            {
              "id": "D",
              "label": "专练静音期间保持拍子、再接回命中点",
              "signal": "practice_seeker"
