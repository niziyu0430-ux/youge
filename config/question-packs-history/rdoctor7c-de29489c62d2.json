              "id": "B",
              "label": "让熟悉心跳和输入不断接起来，享受连续回应",
              "signal": "feedback_engine"
            },
            {
              "id": "C",
              "label": "带着高于旧评价或准确率的明确目标，正常演奏一次",
              "signal": "rank_worker"
            },
            {
              "id": "D",
              "label": "专练那一轮从心跳声等到第七拍的时机",
