          "source_ids": [
            "ML9F_STORE",
            "ML9F_CONSTRUCTION",
            "ML9F_REWORK"
          ],
          "modes": [
            "default"
          ],
          "options": [
            {
              "id": "A",
              "label": "把田间农时、后院食物、柴薪与施工用工连着照看几季，依据区域库存和家庭需求再改分工",
              "signal": "systems_builder"
            },
            {
              "id": "B",
              "label": "比较目前以采集补食物和先加燃料供应这两种供给安排，再决定哪边先加家庭",
